  "info": {
    "description": "UK-style private medical insurance pricing on US MEPS data. The premium is a risk premium (expected claims cost) in dollars, with illustrative pounds alongside, excluding expenses and margin. Statistical analysis only, source AHRQ MEPS.",
    "title": "Health pricing service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
