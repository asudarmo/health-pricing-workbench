# Copy to deploy/.env on the VM. Never commit it.
IMAGE_TAG=latest-or-a-git-sha
# Caddy gets the certificate for this name itself. Use <external-ip-with-dashes>.sslip.io, e.g. 34-82-1-2.sslip.io
SITE_ADDRESS=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Grafana Cloud (OTLP). Copy the values from the stack's OpenTelemetry "View connection details" page.
# Write the header as Authorization=Basic <token> with a plain space (tested: %20 gave 401 with this SDK version).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
